{
  "name": "@dshtrading/ru",
  "version": "0.1.0",
  "description": "RU market bundle for dsh-trading: read-only TRANSAQ connector for MOEX (market ru / provider finam).",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "cordis.patch.yml",
    "README.md",
    "QUICKSTART.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
