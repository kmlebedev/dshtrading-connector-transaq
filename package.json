  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmlebedev/dshtrading-connector-transaq.git"
  },
  "homepage": "https://kmlebedev.github.io/dshtrading-connector-transaq/",
  "author": {
    "name": "kmlebedev",
    "url": "https://github.com/kmlebedev"
  },
  "keywords": [
    "dsh",
